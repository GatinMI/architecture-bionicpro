        <!-- Рёбра -->
        <mxCell id="e1" value="1. «Download Report» в приложении" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" parent="1" source="pilot" target="fe" edge="1">
