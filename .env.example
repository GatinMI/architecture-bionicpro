# Креденциалы OAuth-приложения Яндекс ID (oauth.yandex.ru, тип «Веб-сервис»,
# redirect URI: http://localhost:8080/realms/reports-realm/broker/yandex/endpoint,
# права: «Логин, имя и фамилия, пол» + «Адрес электронной почты»)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Airflow: uid хост-пользователя для владения файлами dags/logs/config/plugins
# (на Linux поставьте $(id -u); без него файлы будут владены uid 50000)
AIRFLOW_UID=
